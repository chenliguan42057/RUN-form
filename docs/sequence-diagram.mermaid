%% ============================================================
%% 4.4 钉钉自动提醒（GitHub Actions，15 分钟窗口 + 幂等去重）
%% ============================================================
%% sequenceDiagram
%%     autonumber
%%     participant CR as GitHub cron */15 * * * *
%%     participant WF as dingtalk-reminder.yml
%%     participant REPO as 仓库文件
%%     participant PY as Python 脚本
%%     participant DT as 钉钉机器人
%%
%%     CR->>WF: 触发（可能延迟 5~20 分钟）
%%     WF->>REPO: actions/checkout@v4
%%     WF->>PY: 执行内联 Python
%%
%%     PY->>PY: now = UTC → 北京时间(+08:00)，秒归零
%%     PY->>PY: win_end = now；win_start = now - 30min
%%     PY->>PY: candidate_days = {win_start.date(), win_end.date()}
%%     PY->>REPO: 读 data/plans.json
%%     REPO-->>PY: Plan[]（失败 → []）
%%     PY->>REPO: 读 data/reminder-state.json
%%     REPO-->>PY: {"sent": {...}}（失败 → {"sent":{}}）
%%
%%     loop 每个 enabled 计划 × 每个候选日期 d
%%         PY->>PY: matches_freq(plan, d)?
%%         PY->>PY: dt = d + plan.time；win_start <= dt <= win_end?
%%         PY->>PY: key = f"{d}|{plan.id}" 是否已在 sent?
%%         alt 全部通过
%%             PY->>PY: due.append((plan, d, dt, key))
%%         end
%%     end
%%
%%     alt due 为空
%%         PY-->>WF: 输出 sent_any=false → exit 0（绿色，不提交）
%%     else 有到期计划
%%         loop ≤2 个逐条发 / >2 个合并一条
%%             PY->>PY: 组装 markdown（问候+图标+名称+说明+原定时间+频率+下次提醒+累计触达+梵高语录+链接+@手机号）
%%             PY->>PY: HMAC-SHA256 签名 → base64 → urlencode
%%             PY->>DT: POST {webhook}&timestamp=..&sign=..
%%             DT-->>PY: {"errcode": 0}
%%             alt errcode == 0
%%                 PY->>PY: sent[key] = epoch；sent_any = True
%%             else errcode != 0
%%                 PY->>PY: 记录失败，不写 key（下轮可重试）
%%             end
%%             PY->>PY: sleep(1)（钉钉限流 20 条/分钟）
%%         end
%%         PY->>PY: GC 删除 date < today-180d 的键
%%         PY->>REPO: 写 data/reminder-state.json
%%     end
%%
%%     alt sent_any == true
%%         WF->>REPO: git add data/reminder-state.json（仅此一个文件）
%%         WF->>REPO: git pull --rebase --autostash → commit → push（重试 3 次）
%%     else
%%         WF->>WF: 跳过提交，避免空 commit
%%     end
%%     alt 存在发送失败
%%         WF-->>CR: exit 1（workflow 变红）
%%     end
